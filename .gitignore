# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ── Node / Next.js ────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.next/
out/
build/
coverage/
*.tsbuildinfo
next-env.d.ts

# ── Python ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
dist/
*.egg-info/
.ruff_cache/
.mypy_cache/

# ── Env / secrets ─────────────────────────────────────────
.env
.env.local
.env*.local

# ── Misc ──────────────────────────────────────────────────
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.vercel
