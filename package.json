{
  "name": "arraia-teixeira-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "web": "cd apps/web && npm run dev",
    "api": "cd apps/api && uvicorn app.main:app --reload --port ${API_PORT:-8000}",
    "dev": "concurrently --names \"WEB,API\" --prefix-colors \"cyan,magenta\" \"npm run web\" \"npm run api\"",
    "install:web": "cd apps/web && npm install",
    "build:web": "cd apps/web && npm run build"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
